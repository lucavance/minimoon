///|
type Path = @path.Path

///|
struct Template {
  name : String
  package_name : String
  app_source : String
  generated_by : String
  description : String
  template_files : ReadOnlyArray[String]
} derive(Debug)

///|
let starter_template_files : ReadOnlyArray[String] = [
  "src/pages/home/page.mbt", "src/pages/home/page_test.mbt", "src/pages/home/moon.pkg",
  "src/pages/details/page.mbt", "src/pages/details/page_test.mbt", "src/pages/details/moon.pkg",
  "styles/tailwind.css",
]

///|
fn usage() -> String {
  (
    #|Usage:
    #|  minimoon --version
    #|  minimoon init <appDir> [--name <app_name>] [--template starter] [--minimoon-root <path>]
    #|  minimoon build [appDir|miniapp.minimoon.json] [--mode dev|release]
    #|  minimoon build --config <miniapp.minimoon.json> [--mode dev|release]
    #|  minimoon dev [appDir|miniapp.minimoon.json] [--debounce-ms <milliseconds>]
    #|  minimoon add page <name> [--route <route>] [--title <title>] [--after <page-id>]
    #|  minimoon add component <name> --page <page-id>
    #|  minimoon verify [appDir|miniapp.minimoon.json] [--candidate|--release] [--json]
    #|  minimoon devtools record [appDir|miniapp.minimoon.json] --status passed|failed --recorded-at <timestamp> --tool-version <version> [--notes <text>]
    #|  minimoon metrics [--json] [--include-untracked]
    #|  minimoon check [mvp|candidate|all] [--suite <suite>]
    #|
    #|Templates:
    #|  starter  Production-friendly two-page MiniApp starter (default)
    #|
    #|Examples:
    #|  minimoon init /tmp/minimoon-starter
    #|  minimoon build /tmp/minimoon-starter
    #|  minimoon build examples/miniapp_draft_workbench --mode dev
    #|  minimoon verify examples/miniapp_draft_workbench
  )
}

///|
fn[A] fail(message : String) -> A {
  println("minimoon: " + message)
  println("")
  println(usage())
  @sys.exit(1)
  abort(message)
}

///|
fn arg(args : Array[String], index : Int, label : String) -> String {
  match args.get(index) {
    Some(value) => value
    None => fail("missing " + label)
  }
}

///|
fn decimal_arg(value : String, label : String) -> Int {
  guard value != "" else { return fail(label + " must be an integer") }
  let result = Ref(0)
  for index = 0; index < value.length(); index = index + 1 {
    let ch = value[index]
    guard ch >= '0' && ch <= '9' else {
      return fail(label + " must be an integer: " + value)
    }
    result.val = result.val * 10 + ch.to_int() - '0'.to_int()
  }
  result.val
}

///|
fn join_path(base : String, child : String) -> String {
  Path::join(base, child).to_string()
}

///|
fn dirname(path : String) -> String {
  Path::dirname(path).to_string()
}

///|
fn basename(path : String) -> String {
  Path::basename(path).to_owned()
}

///|
fn resolve_from(cwd : String, value : String) -> String {
  if Path::is_absolute(value) {
    Path::normalize(value).to_string()
  } else {
    Path::join(cwd, value).normalize().to_string()
  }
}

///|
fn relative_to(path : String, base : String) -> String {
  Path::relative(path, base~).to_string()
}

///|
fn replace_all(
  source : String,
  needle : String,
  replacement : String,
) -> String {
  source.split(needle).collect().join(replacement)
}

///|
fn is_valid_app_name(name : String) -> Bool {
  guard name.length() > 0 else { false }
  let first = name[0]
  let first_ok = (first >= 'A' && first <= 'Z') ||
    (first >= 'a' && first <= 'z')
  guard first_ok else { false }
  for index = 1; index < name.length(); index = index + 1 {
    let ch = name[index]
    let ok = (ch >= 'A' && ch <= 'Z') ||
      (ch >= 'a' && ch <= 'z') ||
      (ch >= '0' && ch <= '9') ||
      ch == '_'
    if !ok {
      return false
    }
  }
  true
}

///|
fn app_name_from_dir(cwd : String, target_dir : String) -> String {
  let base_name = basename(resolve_from(cwd, target_dir))
  let builder = StringBuilder()
  let mut previous_underscore = false
  for ch in base_name {
    let ok = (ch >= 'A' && ch <= 'Z') ||
      (ch >= 'a' && ch <= 'z') ||
      (ch >= '0' && ch <= '9') ||
      ch == '_'
    if ok {
      builder.write_char(ch)
      previous_underscore = false
    } else if !previous_underscore {
      builder.write_char('_')
      previous_underscore = true
    }
  }
  let raw = builder.to_string()
  let trimmed = raw.trim(chars="_")
  if trimmed == "" {
    "minimoon_starter_app"
  } else {
    trimmed.to_owned()
  }
}

///|
fn template_for(name : String) -> Template {
  let template_name = if name == "default" { "starter" } else { name }
  match template_name {
    "starter" =>
      {
        name: "starter",
        package_name: "lampclaw/minimoon_starter_app",
        app_source: "src/pages/home/page.mbt",
        generated_by: "minimoon init --template starter",
        description: "Minimoon two-page MiniApp generated by minimoon init.",
        template_files: starter_template_files,
      }
    "counter" | "profile" | "minimal" =>
      fail("init template '" + name + "' was removed; use --template starter")
    _ =>
      fail("unknown init template: " + name + ". Available template: starter")
  }
}

///|
struct InitArgs {
  target : String
  name : String?
  template : String
  show_help : Bool
} derive(Debug)

///|
struct InitPlan {
  target_dir : String
  relative_target_dir : String
  app_name : String
  package_name : String
  local_root : String?
  template : Template
} derive(Debug)

///|
struct ManifestFile {
  path : String
  content : String
} derive(Debug)

///|
struct InitManifest {
  target_dir : String
  relative_target_dir : String
  app_name : String
  template_name : String
  files : Array[ManifestFile]
} derive(Debug)

///|
struct BuildArgs {
  target : String?
  mode : String
  show_help : Bool
} derive(Debug)

///|
fn parse_init_args(args : Array[String], start : Int) -> InitArgs {
  let positional : Array[String] = []
  let mut name : String? = None
  let mut template = "starter"
  let mut index = start
  while index < args.length() {
    let item = args[index]
    if item == "--name" {
      name = Some(arg(args, index + 1, "--name value"))
      index = index + 2
    } else if item.has_prefix("--name=") {
      name = Some(item["--name=".length():].to_owned())
      index = index + 1
    } else if item == "--template" {
      template = arg(args, index + 1, "--template value")
      index = index + 2
    } else if item.has_prefix("--template=") {
      template = item["--template=".length():].to_owned()
      index = index + 1
    } else if item == "--help" || item == "-h" {
      return { target: "", name, template, show_help: true, }
    } else if item.has_prefix("-") {
      fail("unknown init option: " + item)
    } else {
      positional.push(item)
      index = index + 1
    }
  }
  if positional.length() != 1 {
    fail("init requires exactly one app directory, got \{positional.length()}")
  }
  { target: positional[0], name, template, show_help: false, }
}

///|
fn parse_build_args(args : Array[String], start : Int) -> BuildArgs {
  let positional : Array[String] = []
  let mut config : String? = None
  let mut mode = "release"
  let mut index = start
  while index < args.length() {
    let item = args[index]
    if item == "--mode" {
      mode = arg(args, index + 1, "--mode value")
      index = index + 2
    } else if item.has_prefix("--mode=") {
      mode = item["--mode=".length():].to_owned()
      index = index + 1
    } else if item == "--config" {
      config = Some(arg(args, index + 1, "--config value"))
      index = index + 2
    } else if item.has_prefix("--config=") {
      config = Some(item["--config=".length():].to_owned())
      index = index + 1
    } else if item == "--help" || item == "-h" {
      return { target: None, mode, show_help: true, }
    } else if item.has_prefix("-") {
      fail("unknown build option: " + item)
    } else {
      positional.push(item)
      index = index + 1
    }
  }
  if positional.length() > 1 {
    fail(
      "build accepts at most one app directory or config path, got \{positional.length()}",
    )
  }
  if config is Some(_) && positional.length() > 0 {
    fail(
      "use either --config or a positional app directory/config path, not both",
    )
  }
  if mode != "dev" && mode != "release" {
    fail("unsupported mode: " + mode)
  }
  let target = match config {
    Some(value) => Some(value)
    None => positional.get(0)
  }
  { target, mode, show_help: false, }
}

///|
