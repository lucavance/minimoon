///|
let embedded_template_files : Map[String, String] = {
  "starter:src/pages/home/page.mbt": "///|\npub struct Model {\n  count : Int\n  name : String\n  visits : Int\n} derive(Eq)\n\n///|\npub enum Msg {\n  Increment\n  Decrement\n  NameInput(String)\n  OpenDetails\n  PageShown\n}\n\n///|\nfn update(model : Model, msg : Msg) -> (Model, @minimoon.Cmd) {\n  match msg {\n    Increment => @minimoon.no_cmd({ ..model, count: model.count + 1, })\n    Decrement => @minimoon.no_cmd({ ..model, count: model.count - 1, })\n    NameInput(name) => @minimoon.no_cmd({ ..model, name, })\n    OpenDetails =>\n      @minimoon.with_cmd(\n        model,\n        @minimoon.navigate_to(\n          @minimoon.route(\"pages/details/details\").with_query([\n            @minimoon.query(\"from\", model.name),\n          ]),\n        ),\n      )\n    PageShown => @minimoon.no_cmd({ ..model, visits: model.visits + 1, })\n  }\n}\n\n///|\nfn view(model : Model, emit : @minimoon.Emit[Msg]) -> @minimoon.Node {\n  @minimoon.div(\n    class=\"min-h-[100vh] bg-slate-100 px-[40rpx] pt-[120rpx] text-slate-800\",\n    [\n      @minimoon.h1(\n        class=\"text-[40rpx] font-semibold text-sky-700\",\n        \"Hello \" + model.name,\n      ),\n      @minimoon.p(\n        class=\"mt-[12rpx] text-[26rpx] text-slate-600\",\n        \"page visits: \" + model.visits.to_string(),\n      ),\n      @minimoon.div(\n        class=\"mt-[20rpx] rounded-[16rpx] bg-white px-[28rpx] py-[24rpx]\",\n        data_section=\"starter-home\",\n        [\n          @minimoon.p(\n            class=\"text-[56rpx] font-semibold text-sky-700\",\n            model.count.to_string(),\n          ),\n          @minimoon.div(class=\"mt-[16rpx] flex gap-[12rpx]\", [\n            @minimoon.button(\n              on_tap=emit(Decrement),\n              event_key=\"home/decrement\",\n              class=\"rounded-[10rpx] bg-slate-700 px-[24rpx] py-[12rpx] text-white\",\n              \"-1\",\n            ),\n            @minimoon.button(\n              on_tap=emit(Increment),\n              event_key=\"home/increment\",\n              class=\"rounded-[10rpx] bg-sky-600 px-[24rpx] py-[12rpx] text-white\",\n              \"+1\",\n            ),\n          ]),\n          @minimoon.input(\n            value=model.name,\n            on_input=emit.map(value => NameInput(value)),\n            event_key=\"home/name\",\n            placeholder=\"Your name\",\n            class=\"mt-[20rpx] rounded-[10rpx] bg-slate-100 px-[20rpx] py-[14rpx]\",\n          ),\n          @minimoon.button(\n            on_tap=emit(OpenDetails),\n            event_key=\"home/open-details\",\n            class=\"mt-[20rpx] rounded-[10rpx] bg-violet-600 px-[24rpx] py-[14rpx] text-white\",\n            \"Open details\",\n          ),\n        ],\n      ),\n    ],\n  )\n}\n\n///|\npub fn program() -> @minimoon.Page {\n  @minimoon.elmish_page(\n    id=\"home\",\n    route=@minimoon.route(\"pages/home/home\"),\n    title=\"Home\",\n    model={ count: 0, name: \"Minimoon\", visits: 0, },\n    update=(current, message, _) => update(current, message),\n    view~,\n    capabilities=[@minimoon.NavigateTo],\n    subscriptions=(context, _, emit) => context.on_show(emit(PageShown)),\n  )\n}\n",
  "starter:src/pages/home/page_test.mbt": "///|\ntest \"starter home owns state, lifecycle, controlled input, and navigation\" {\n  let runtime = program().create_runtime()\n  let _ = runtime.mount()\n  let _ = runtime.lifecycle(\"onShow\", \"{}\")\n  let _ = runtime.dispatch(\"home/increment\", \"{}\")\n  let _ = runtime.dispatch(\"home/name\", \"{\\\"detail\\\":{\\\"value\\\":\\\"MoonBit\\\"}}\")\n  let snapshot = runtime.snapshot()\n  inspect(snapshot.contains(\"Hello MoonBit\"), content=\"true\")\n  inspect(snapshot.contains(\"page visits: 1\"), content=\"true\")\n  inspect(snapshot.contains(\"\\\"text\\\":\\\"1\\\"\"), content=\"true\")\n  let navigation = runtime.dispatch(\"home/open-details\", \"{}\")\n  inspect(navigation.contains(\"/pages/details/details\"), content=\"true\")\n  inspect(navigation.contains(\"from=MoonBit\"), content=\"true\")\n}\n",
  "starter:src/pages/home/moon.pkg": "import {\n  \"lampclaw/minimoon\",\n}\n\nsupported_targets = \"js\"\n\nimport {\n  \"moonbitlang/core/test\",\n} for \"test\"\n",
  "starter:src/pages/details/page.mbt": "///|\npub struct Model {\n  enabled : Bool\n  visits : Int\n} derive(Eq)\n\n///|\npub enum Msg {\n  Toggle\n  PageShown\n  Back\n}\n\n///|\nfn view(\n  model : Model,\n  emit : @minimoon.Emit[Msg],\n  source : String,\n) -> @minimoon.Node {\n  @minimoon.div(\n    class=\"min-h-[100vh] bg-slate-100 px-[40rpx] pt-[120rpx] text-slate-800\",\n    [\n      @minimoon.div(\n        class=\"rounded-[16rpx] bg-white px-[28rpx] py-[24rpx]\",\n        data_section=\"starter-details\",\n        [\n          @minimoon.h1(\n            class=\"text-[40rpx] font-semibold text-violet-700\",\n            \"Details\",\n          ),\n          @minimoon.p(class=\"mt-[12rpx] text-[26rpx]\", \"from: \" + source),\n          @minimoon.p(\n            class=\"mt-[12rpx] text-[26rpx]\",\n            \"enabled: \" + model.enabled.to_string(),\n          ),\n          @minimoon.p(\n            class=\"mt-[12rpx] text-[26rpx]\",\n            \"page visits: \" + model.visits.to_string(),\n          ),\n          @minimoon.div(class=\"mt-[20rpx] flex gap-[12rpx]\", [\n            @minimoon.button(\n              on_tap=emit(Toggle),\n              event_key=\"details/toggle\",\n              class=\"rounded-[10rpx] bg-emerald-600 px-[24rpx] py-[14rpx] text-white\",\n              \"Toggle\",\n            ),\n            @minimoon.button(\n              on_tap=emit(Back),\n              event_key=\"details/back\",\n              class=\"rounded-[10rpx] bg-sky-600 px-[24rpx] py-[14rpx] text-white\",\n              \"Back\",\n            ),\n          ]),\n        ],\n      ),\n    ],\n  )\n}\n\n///|\nfn app(\n  context : @minimoon.PageContext,\n  source : @minimoon.Val[String],\n) -> @minimoon.Val[@minimoon.Node] {\n  let (model, emit) = @minimoon.create_state(\n    { enabled: false, visits: 0, },\n    update=(current, message, _) => {\n      match message {\n        Toggle => @minimoon.no_cmd({ ..current, enabled: !current.enabled, })\n        PageShown =>\n          @minimoon.no_cmd({ ..current, visits: current.visits + 1, })\n        Back =>\n          @minimoon.with_cmd(\n            current,\n            @minimoon.navigate_back_or(\n              fallback=@minimoon.route(\"pages/home/home\"),\n            ),\n          )\n      }\n    },\n    subscriptions=(_, emit) => context.on_show(emit(PageShown)),\n  )\n  model.view2(source, (current, value) => view(current, emit, value))\n}\n\n///|\nfn decode_input(\n  fields : Map[String, String],\n) -> Result[String, @minimoon.DecodeError] {\n  Ok(fields.get(\"from\").unwrap_or(\"Home\"))\n}\n\n///|\npub fn program() -> @minimoon.Page {\n  @minimoon.page_with_input(\n    id=\"details\",\n    route=@minimoon.route(\"pages/details/details\"),\n    title=\"Details\",\n    capabilities=[@minimoon.NavigateBack, @minimoon.RedirectTo],\n    decode_input~,\n    build=app,\n  )\n}\n",
  "starter:src/pages/details/page_test.mbt": "///|\ntest \"starter details decodes query and keeps independent page state\" {\n  let runtime = program().create_runtime()\n  let _ = runtime.lifecycle(\"onLoad\", \"{\\\"from\\\":\\\"MoonBit\\\"}\")\n  let _ = runtime.lifecycle(\"onShow\", \"{}\")\n  let _ = runtime.dispatch(\"details/toggle\", \"{}\")\n  let snapshot = runtime.snapshot()\n  inspect(snapshot.contains(\"from: MoonBit\"), content=\"true\")\n  inspect(snapshot.contains(\"enabled: true\"), content=\"true\")\n  inspect(snapshot.contains(\"page visits: 1\"), content=\"true\")\n  let back = runtime.dispatch(\"details/back\", \"{}\")\n  inspect(back.contains(\"NavigateBackOrRedirect\"), content=\"true\")\n  inspect(back.contains(\"/pages/home/home\"), content=\"true\")\n}\n",
  "starter:src/pages/details/moon.pkg": "import {\n  \"lampclaw/minimoon\",\n}\n\nsupported_targets = \"js\"\n\nimport {\n  \"moonbitlang/core/test\",\n} for \"test\"\n",
  "starter:styles/tailwind.css": "@import \"tailwindcss\" source(none);\n@source \"../src/**/*.mbt\";\n@source not \"../src/**/*_test.mbt\";\n@source not \"../src/**/*_wbtest.mbt\";\n@source inline(\"min-h-[100vh] bg-slate-100 px-[40rpx] pt-[120rpx] text-slate-800 text-[40rpx] font-semibold text-sky-700 text-violet-700 mt-[12rpx] mt-[16rpx] mt-[20rpx] text-[26rpx] text-[56rpx] text-slate-600 rounded-[16rpx] rounded-[10rpx] bg-white bg-slate-700 bg-sky-600 bg-slate-100 bg-violet-600 bg-emerald-600 px-[20rpx] px-[24rpx] px-[28rpx] py-[12rpx] py-[14rpx] py-[24rpx] flex gap-[12rpx] text-white\");\n",
}
