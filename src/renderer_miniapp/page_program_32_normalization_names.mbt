///|
fn prop_name(name : String) -> String {
  match name {
    "scroll-x" => "scrollX"
    "scroll-y" => "scrollY"
    "scroll-top" => "scrollTop"
    "scroll-left" => "scrollLeft"
    "scroll-top-px" => "scrollTop"
    "scroll-left-px" => "scrollLeft"
    "scroll-into-view" => "scrollIntoView"
    "upper-threshold" => "upperThreshold"
    "lower-threshold" => "lowerThreshold"
    "item-id" => "itemId"
    "open-type" => "openType"
    "alt" => "alt"
    "aria-role" => "role"
    "aria-label" => "ariaLabel"
    "aria-expanded" => "ariaExpanded"
    "aria-selected" => "ariaSelected"
    "aria-disabled" => "ariaDisabled"
    "aria-hidden" => "ariaHidden"
    "aria-checked" => "ariaChecked"
    "aria-modal" => "ariaModal"
    "aria-controls" => "ariaControls"
    "aria-labelledby" => "ariaLabelledBy"
    "aria-describedby" => "ariaDescribedBy"
    "aria-orientation" => "ariaOrientation"
    "aria-haspopup" => "ariaHasPopup"
    "aria-required" => "ariaRequired"
    "aria-invalid" => "ariaInvalid"
    "aria-busy" => "ariaBusy"
    "aria-live" => "ariaLive"
    "aria-valuemin" => "ariaValueMin"
    "aria-valuemax" => "ariaValueMax"
    "aria-valuenow" => "ariaValueNow"
    "aria-valuetext" => "ariaValueText"
    "selection-start" => "selectionStart"
    "selection-end" => "selectionEnd"
    "form-type" => "formType"
    "catch-move" => "catchMove"
    "show-value" => "showValue"
    "active-color" => "activeColor"
    "background-color" => "backgroundColor"
    "block-color" => "blockColor"
    "block-size" => "blockSize"
    "stroke-width" => "strokeWidth"
    "show-info" => "showInfo"
    name => name
  }
}

///|
fn event_prop_name(name : String) -> String {
  match name {
    "on_click" => "tap"
    "on_input" => "input"
    "on_change" => "change"
    "on_confirm" => "confirm"
    "on_focus" => "focus"
    "on_blur" => "blur"
    "on_scroll" => "scroll"
    "on_scrolltoupper" => "upper"
    "on_scrolltolower" => "lower"
    "on_submit" => "submit"
    "on_reset" => "reset"
    "on_changing" => "changing"
    "on_load" => "load"
    "on_error" => "error"
    "on_longpress" => "longpress"
    "on_touchstart" => "touchstart"
    "on_touchmove" => "touchmove"
    "on_touchend" => "touchend"
    "on_touchcancel" => "touchcancel"
    name => abort("unsupported MiniApp event attribute: " + name)
  }
}
