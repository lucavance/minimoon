///|
test "package README authoring examples mount through the public runtime" {
  let composition = readme_composition_page().create_runtime().unwrap()
  ignore(composition.lifecycle("onLoad", "{}"))
  ignore(composition.mount())
  ignore(composition.dispatch("increment", "{}"))
  assert_true(composition.snapshot().contains("\"text\":\"1\""))
  ignore(composition.dispose())
  let page_runtime = readme_page().create_runtime().unwrap()
  ignore(page_runtime.lifecycle("onLoad", "{}"))
  let _ = page_runtime.mount()
  assert_true(page_runtime.snapshot().contains("MoonBit"))
  let _ = page_runtime.dispose()

  let local_runtime = readme_local_page().create_runtime().unwrap()
  ignore(local_runtime.lifecycle("onLoad", "{}"))
  assert_true(local_runtime.snapshot().contains("pending"))
  let _ = local_runtime.mount()
  assert_true(local_runtime.snapshot().contains("ready"))
  let _ = local_runtime.dispose()
}

///|
test "package README App example shares state across page lifetimes" {
  let app = readme_app().create_runtime()
  defer ignore(app.dispose())
  ignore(app.lifecycle("onLaunch", "{}"))
  let first = app.create_page(readme_shared_page(app.deps())).unwrap()
  ignore(first.lifecycle("onLoad", "{}"))
  let second = app.create_page(readme_shared_page(app.deps())).unwrap()
  ignore(second.lifecycle("onLoad", "{}"))
  defer ignore(second.dispose())
  ignore(first.mount())
  ignore(second.mount())
  ignore(first.dispatch("readme/shared/increment", "{}"))
  assert_true(second.snapshot().contains("Shared count: 0"))
  ignore(app.flush())
  ignore(first.refresh())
  ignore(second.refresh())
  assert_true(first.snapshot().contains("Shared count: 1"))
  assert_true(second.snapshot().contains("Shared count: 1"))
  ignore(first.dispose())
  ignore(second.dispatch("readme/shared/increment", "{}"))
  ignore(app.flush())
  ignore(second.refresh())
  assert_true(second.snapshot().contains("Shared count: 2"))
}
