///|
/// Native compact recipes reviewed against RUI 0.3.6 (MIT). Vega rules above
/// remain the base; only descendants of the explicit Nova preset are changed.
fn nova_rules() -> String {
  let rules =
    #|.mmui-nova{font-size:14px;line-height:1.5;--mmui-radius:10px}
    #|.mmui-nova .mmui-button{min-height:32px;padding:0 10px;gap:6px;border-radius:var(--mmui-radius)}.mmui-nova .mmui-button-xs{min-height:24px;padding:0 8px;font-size:12px;border-radius:8px}.mmui-nova .mmui-button-sm{min-height:28px;padding:0 10px;border-radius:8px;font-size:13px}.mmui-nova .mmui-button-lg{min-height:36px;padding:0 10px}.mmui-nova .mmui-button-icon{width:32px;height:32px;padding:0}.mmui-nova .mmui-button-icon-xs{width:24px;height:24px;min-height:24px;padding:0}.mmui-nova .mmui-button-icon-sm{width:28px;height:28px;min-height:28px;padding:0}.mmui-nova .mmui-button-icon-lg{width:36px;height:36px;min-height:36px;padding:0}.mmui-nova .mmui-button-group{gap:4px}
    #|.mmui-nova .mmui-card{padding:16px;gap:16px;border-radius:calc(var(--mmui-radius) + 4px)}.mmui-nova .mmui-card.mmui-small{padding:12px;gap:12px}.mmui-nova .mmui-card.mmui-large{padding:20px;gap:20px}.mmui-nova .mmui-card-header,.mmui-nova .mmui-empty-header{gap:4px}.mmui-nova .mmui-alert{padding:12px;border-radius:8px}.mmui-nova .mmui-avatar{width:32px;height:32px}.mmui-nova .mmui-avatar.mmui-small{width:24px;height:24px}.mmui-nova .mmui-avatar.mmui-large{width:40px;height:40px}.mmui-nova .mmui-badge{padding:2px 6px;border-radius:6px;font-size:11px}.mmui-nova .mmui-breadcrumb{font-size:13px}.mmui-nova .mmui-breadcrumb-list{gap:6px}
    #|.mmui-nova .mmui-input,.mmui-nova .mmui-textarea,.mmui-nova .mmui-native-select,.mmui-nova .mmui-select-trigger{min-height:32px;padding:4px 10px;border-radius:var(--mmui-radius);font-size:16px;background:transparent}.mmui-nova .mmui-input,.mmui-nova .mmui-native-select,.mmui-nova .mmui-select-trigger{height:32px}.mmui-nova .mmui-textarea{min-height:64px}.mmui-nova .mmui-input-group{gap:6px;padding:0 6px}.mmui-nova .mmui-input-otp{gap:6px}.mmui-nova .mmui-input-otp-slot{width:32px;height:36px;font-size:16px}.mmui-nova .mmui-input-otp-separator{padding:0 6px;line-height:36px}.mmui-nova .mmui-field,.mmui-nova .mmui-field-group,.mmui-nova .mmui-field-set,.mmui-nova .mmui-form{gap:8px}.mmui-nova .mmui-label{font-size:13px}.mmui-nova .mmui-field-description,.mmui-nova .mmui-form-description,.mmui-nova .mmui-field-error,.mmui-nova .mmui-form-message{font-size:12px}
    #|.mmui-nova .mmui-checkbox{gap:6px}.mmui-nova .mmui-radio-group{gap:8px}.mmui-nova .mmui-radio-group-item{font-size:13px}.mmui-nova .mmui-toggle{min-height:32px;padding:6px 10px;font-size:14px;border-radius:var(--mmui-radius)}.mmui-nova .mmui-toggle-group{gap:2px}.mmui-nova .mmui-slider-thumb{width:16px;height:16px;margin-top:-8px;margin-left:-8px}.mmui-nova .mmui-slider-track,.mmui-nova .mmui-slider-range{height:4px}.mmui-nova .mmui-slider.mmui-vertical .mmui-slider-track,.mmui-nova .mmui-slider.mmui-vertical .mmui-slider-range{width:4px}.mmui-nova .mmui-slider.mmui-vertical .mmui-slider-track{height:100%}.mmui-nova .mmui-slider.mmui-vertical .mmui-slider-range{height:auto}.mmui-nova .mmui-slider.mmui-vertical .mmui-slider-thumb{margin-top:0;margin-bottom:-8px}.mmui-nova .mmui-progress-value,.mmui-nova .mmui-progress-label{font-size:12px}.mmui-nova .mmui-switch.mmui-small{transform:scale(0.75)}
    #|.mmui-nova .mmui-dialog,.mmui-nova .mmui-alert-dialog,.mmui-nova .mmui-sheet,.mmui-nova .mmui-drawer{border-radius:12px;padding:16px}.mmui-nova .mmui-popover,.mmui-nova .mmui-hover-card,.mmui-nova .mmui-tooltip,.mmui-nova .mmui-dropdown-menu,.mmui-nova .mmui-context-menu,.mmui-nova .mmui-menubar,.mmui-nova .mmui-navigation-menu{border-radius:8px;padding:4px}.mmui-nova .mmui-select-panel,.mmui-nova .mmui-command{border-radius:8px}.mmui-nova .mmui-menu-item{min-height:28px;padding:6px 8px;font-size:13px}.mmui-nova .mmui-combobox,.mmui-nova .mmui-data-table,.mmui-nova .mmui-date-picker-content{gap:8px;font-size:13px}.mmui-nova .mmui-calendar-day.mmui-selected{background:var(--mmui-primary);color:var(--mmui-primary-foreground)}.mmui-nova .mmui-select-item,.mmui-nova .mmui-command-item{padding:6px 8px;font-size:13px}.mmui-nova .mmui-select-label{padding:4px 8px;font-size:11px}
    #|.mmui-nova .mmui-accordion-trigger,.mmui-nova .mmui-collapsible-trigger{min-height:40px;font-size:14px}.mmui-nova .mmui-accordion-panel,.mmui-nova .mmui-collapsible-content,.mmui-nova .mmui-tab-panel{padding:8px 0}.mmui-nova .mmui-tabs-default{padding:3px;border-radius:8px}.mmui-nova .mmui-tab{min-height:28px;font-size:13px}.mmui-nova .mmui-calendar{font-size:13px}.mmui-nova .mmui-calendar-day{min-width:28px;min-height:28px}.mmui-nova .mmui-table{font-size:13px}.mmui-nova .mmui-table-cell,.mmui-nova .mmui-table-head{padding:8px}.mmui-nova .mmui-pagination{gap:4px}.mmui-nova .mmui-chart{font-size:12px}.mmui-nova .mmui-carousel{gap:8px}
    #|.mmui-nova .mmui-item{gap:8px;padding:12px;border-radius:8px}.mmui-nova .mmui-item-group{gap:6px}.mmui-nova .mmui-empty{gap:12px;padding:24px;border-radius:8px}.mmui-nova .mmui-empty-media{padding:8px;border-radius:8px}.mmui-nova .mmui-attachment{border-radius:8px}.mmui-nova .mmui-bubble{padding:8px 12px;border-radius:10px}.mmui-nova .mmui-bubble.mmui-ghost{padding:0;border-radius:0}.mmui-nova .mmui-bubble-group,.mmui-nova .mmui-message-group{gap:6px}.mmui-nova .mmui-message{gap:8px}.mmui-nova .mmui-message-content{gap:4px}.mmui-nova .mmui-marker-border{padding:6px;border-radius:6px}.mmui-nova .mmui-kbd{min-width:18px;height:18px;font-size:10px}.mmui-nova .mmui-kbd-group{gap:4px}
    #|.mmui-nova .mmui-toast,.mmui-nova .mmui-sonner{padding:12px;border-radius:8px;font-size:13px}.mmui-nova .mmui-spinner{width:20px;height:20px;font-size:20px}.mmui-nova .mmui-spinner.mmui-small{width:14px;height:14px;font-size:14px}.mmui-nova .mmui-spinner.mmui-large{width:28px;height:28px;font-size:28px}.mmui-nova .mmui-skeleton{border-radius:6px}.mmui-nova .mmui-sidebar{font-size:13px}.mmui-nova .mmui-scroll-area,.mmui-nova .mmui-message-scroller,.mmui-nova .mmui-resizable,.mmui-nova .mmui-aspect-ratio,.mmui-nova .mmui-direction{min-width:0}.mmui-nova .mmui-separator{background:var(--mmui-border)}
    #|.mmui-nova .mmui-typography-h1{font-size:30px;line-height:1.2}.mmui-nova .mmui-typography-h2{font-size:24px;line-height:1.25}.mmui-nova .mmui-typography-h3{font-size:20px}.mmui-nova .mmui-typography-h4{font-size:16px}.mmui-nova .mmui-typography-p{line-height:1.7}.mmui-nova .mmui-disabled{opacity:0.5}.mmui-nova .mmui-focused{border-color:var(--mmui-primary)}.mmui-nova .mmui-invalid{border-color:var(--mmui-destructive)}.mmui-nova .mmui-readonly{opacity:1}.mmui-nova .mmui-selected{background:var(--mmui-muted);color:var(--mmui-foreground)}
    #|.mmui-nova.mmui-light{--mmui-foreground:#0a0a0a;--mmui-primary:#171717;--mmui-destructive:#e7000b}.mmui-nova.mmui-dark{--mmui-background:#0a0a0a;--mmui-primary-foreground:#171717;--mmui-border:#ffffff1a;--mmui-destructive:#ff6467}.mmui-nova .mmui-button-destructive{background:#e7000b1a;color:var(--mmui-destructive)}.mmui-nova.mmui-dark .mmui-button-destructive{background:#ff646733}.mmui-nova .mmui-card-title{font-size:16px;font-weight:500}.mmui-nova .mmui-card-description{font-size:14px}.mmui-nova.mmui-dark .mmui-input,.mmui-nova.mmui-dark .mmui-textarea{background:#ffffff0b}
  rules
}
