///|
fn attachment_rules() -> String {
  let rules =
    #|.mmui-attachment{display:flex;position:relative;max-width:100%;min-width:0;flex-shrink:0;border:1px solid var(--mmui-border);border-radius:12px;background:var(--mmui-background);color:var(--mmui-foreground);gap:8px;padding:8px;font-size:14px;--mmui-attachment-media-size:40px}
    #|.mmui-attachment-default{--mmui-attachment-media-size:40px}.mmui-attachment-sm{--mmui-attachment-media-size:32px;padding:6px;gap:10px;font-size:12px}.mmui-attachment-xs{--mmui-attachment-media-size:28px;padding:4px;gap:6px;font-size:12px;border-radius:8px}.mmui-attachment.mmui-vertical{width:120px;align-items:stretch}.mmui-attachment.mmui-horizontal{min-width:160px}
    #|.mmui-attachment-idle{border-style:dashed}.mmui-attachment-error{border-color:var(--mmui-destructive);color:var(--mmui-destructive)}.mmui-attachment-done .mmui-attachment-image{opacity:1}.mmui-attachment-uploading .mmui-attachment-image,.mmui-attachment-processing .mmui-attachment-image,.mmui-attachment-error .mmui-attachment-image{opacity:0.6}.mmui-attachment-uploading .mmui-attachment-title,.mmui-attachment-processing .mmui-attachment-title{animation:mmui-pulse 2s ease-in-out infinite}
    #|.mmui-attachment-group{width:100%;white-space:nowrap;padding:4px}.mmui-attachment-group .mmui-attachment{display:inline-flex;margin-right:12px;white-space:normal}.mmui-attachment-media{display:flex;position:relative;flex-shrink:0;align-items:center;justify-content:center;width:var(--mmui-attachment-media-size);height:var(--mmui-attachment-media-size);overflow:hidden;border-radius:8px;background:var(--mmui-muted)}.mmui-attachment.mmui-vertical .mmui-attachment-media{width:100%;height:96px}.mmui-attachment-image-content{width:100%;height:100%}.mmui-attachment-image{padding:0}.mmui-attachment-icon{font-size:20px;color:var(--mmui-foreground)}
    #|.mmui-attachment-content{flex:1;min-width:0;line-height:1.25}.mmui-attachment-title{font-weight:500;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.mmui-attachment-description{font-size:12px;color:var(--mmui-muted-foreground)}.mmui-attachment-error .mmui-attachment-description{color:var(--mmui-destructive)}.mmui-attachment-actions{display:flex;align-items:center;gap:4px}.mmui-attachment-action,.mmui-attachment-trigger{flex-shrink:0}.mmui-native-select.mmui-small,.mmui-toggle.mmui-small{min-height:28px;padding:4px 8px;font-size:12px}.mmui-native-select.mmui-large,.mmui-toggle.mmui-large{min-height:40px;padding:10px 16px;font-size:16px}
  rules
}
