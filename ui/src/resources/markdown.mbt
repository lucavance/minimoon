///|
fn markdown_rules() -> String {
  let rules =
    #|.mmui-markdown{line-height:1.7;min-width:0;word-break:break-word}.mmui-markdown-p{margin:8px 0}.mmui-markdown-h1{font-size:30px;font-weight:700;margin:20px 0 12px}.mmui-markdown-h2{font-size:24px;font-weight:600;margin:16px 0 10px}.mmui-markdown-h3{font-size:20px;font-weight:600;margin:12px 0 8px}.mmui-markdown-h4,.mmui-markdown-h5,.mmui-markdown-h6{font-size:16px;font-weight:600;margin:10px 0 6px}.mmui-markdown-quote{border-left:3px solid var(--mmui-border);padding-left:12px;color:var(--mmui-muted-foreground)}.mmui-rtl .mmui-markdown-quote{border-left:0;border-right:3px solid var(--mmui-border);padding-left:0;padding-right:12px}.mmui-markdown-list-item{display:flex;align-items:flex-start;gap:8px;margin:4px 0}.mmui-markdown-list-content{flex:1;min-width:0}.mmui-markdown-code{font-family:monospace;background:var(--mmui-muted);border-radius:4px;padding:1px 4px}.mmui-markdown-codeblock{white-space:pre;font-family:monospace;padding:12px;background:var(--mmui-muted);border-radius:8px;min-width:100%;box-sizing:border-box}.mmui-markdown-scroll{width:100%}.mmui-markdown-link{color:var(--mmui-primary);text-decoration:underline}.mmui-markdown-image{width:1em;height:1em;vertical-align:middle}.mmui-markdown-table{display:flex;flex-direction:column;min-width:100%}.mmui-markdown-row{display:flex}.mmui-markdown-cell{width:160px;flex-shrink:0;border:1px solid var(--mmui-border);padding:8px;box-sizing:border-box}.mmui-markdown-header{font-weight:600;background:var(--mmui-muted)}.mmui-markdown-footnotes{border-top:1px solid var(--mmui-border);margin-top:16px;font-size:12px}.mmui-markdown-html{white-space:pre-wrap}.mmui-markdown-rule{height:1px;background:var(--mmui-border);margin:12px 0}
  rules
}
