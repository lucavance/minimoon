///|
test "details page decodes navigation input and owns lifecycle state" {
  let runtime_app = @application.program().create_runtime()
  defer ignore(runtime_app.dispose())
  let runtime = runtime_app
    .create_page(program(runtime_app.deps()), input={ "from": "test" })
    .unwrap()
  let _ = runtime.lifecycle("onLoad", "{\"from\":\"test\"}")
  let _ = runtime.lifecycle("onShow", "{}")
  let tree = runtime.snapshot()
  inspect(tree.contains("\"section\":\"details-card\""), content="true")
  inspect(
    tree.contains(
      "Independent page state generated by Minimoon / 独立页面状态",
    ),
    content="true",
  )
  inspect(tree.contains("from: test"), content="true")
  inspect(tree.contains("visits: 1"), content="true")
  inspect(tree.contains("返回 / Back"), content="true")
}

///|
test "details delegates stack-aware back fallback to the host" {
  let runtime_app = @application.program().create_runtime()
  defer ignore(runtime_app.dispose())
  let runtime = runtime_app
    .create_page(program(runtime_app.deps()), input={ "from": "test" })
    .unwrap()
  let _ = runtime.lifecycle("onLoad", "{\"from\":\"test\"}")
  let _ = runtime.mount()
  let command = runtime.dispatch("Back", "{}")
  inspect(
    command.contains("\"type\":\"NavigateBackOrRedirect\""),
    content="true",
  )
  inspect(command.contains("\"delta\":1"), content="true")
  inspect(command.contains("/pages/showcase/showcase"), content="true")
}

///|
fn open_details(
  app : @minimoon.AppRuntime[@application.Deps],
) -> @minimoon.PageRuntime {
  let page = app
    .create_page(program(app.deps()), input={ "from": "test" })
    .unwrap()
  ignore(page.lifecycle("onLoad", "{\"from\":\"test\"}"))
  ignore(page.lifecycle("onShow", "{}"))
  ignore(page.mount())
  page
}

///|
fn edit_draft(
  page : @minimoon.PageRuntime,
  title : String,
  note : String,
) -> Unit {
  for field in [("details/draft-title", title), ("details/draft-note", note)] {
    ignore(
      page.dispatch(
        field.0,
        Json::object({
          "detail": Json::object({ "value": Json::string(field.1) }),
        }).stringify(),
      ),
    )
  }
}

///|
fn save_request(page : @minimoon.PageRuntime) -> (String, Json) raise {
  guard @json.parse(page.dispatch("details/save-draft", "{}"))
    is Array(commands) else {
    fail("invalid save command JSON")
  }
  for command in commands {
    if command is Object(fields) &&
      fields.get("capability") == Some(Json::string("wx.request")) &&
      fields.get("request_id") is Some(String(id)) &&
      fields.get("payload") is Some(payload) {
      return (id, payload)
    }
  }
  fail("save did not issue a page-owned request")
}

///|
fn echo_response(title : String, note : String) -> String {
  Json::object({
    "statusCode": (200).to_json(),
    "data": Json::object({
      "json": Json::object({
        "title": Json::string(title),
        "note": Json::string(note),
      }),
      "origin": Json::string("private-origin-marker"),
      "headers": Json::object({
        "x-private": Json::string("private-header-marker"),
      }),
    }),
  }).stringify()
}

///|
test "details requires real route input instead of using its preview sample" {
  let app = @application.program().create_runtime()
  defer ignore(app.dispose())
  assert_true(app.create_page(program(app.deps())) is Err(_))
  assert_true(
    app.create_page(program(app.deps()), input={ "from": "" }) is Err(_),
  )
}

///|
test "details validates a typed draft then shares only its public API echo" {
  let app = @application.program().create_runtime()
  defer ignore(app.dispose())
  ignore(app.lifecycle("onLaunch", "{}"))
  let details = open_details(app)
  let home = app.create_page(@home.program(app.deps())).unwrap()
  ignore(home.lifecycle("onLoad", "{}"))
  ignore(home.mount())
  edit_draft(details, "   ", "note")
  assert_true(
    !details.dispatch("details/save-draft", "{}").contains("InvokeCapability"),
  )
  assert_true(details.snapshot().contains("Title is required."))
  edit_draft(details, "  Release note  ", "MoonBit")
  let (id, payload) = save_request(details)
  guard payload is Object(fields) else {
    fail("save payload must be an object")
  }
  assert_eq(fields["url"], Json::string("https://httpbingo.org/post"))
  assert_eq(fields["method"], Json::string("POST"))
  assert_eq(fields["timeout"], (10000).to_json())
  assert_eq(
    fields["header"],
    Json::object({ "content-type": Json::string("application/json") }),
  )
  guard fields["data"] is String(body) else {
    fail("JSON request body must be encoded once")
  }
  assert_eq(
    @json.parse(body),
    Json::object({
      "title": Json::string("Release note"),
      "note": Json::string("MoonBit"),
    }),
  )
  ignore(
    details.resolve_effect(
      id,
      "success",
      echo_response("Release note", "MoonBit"),
    ),
  )
  ignore(app.flush())
  ignore(details.flush())
  ignore(home.flush())
  for page in [details, home] {
    assert_true(
      page
      .snapshot()
      .contains(
        "Application echoed draft: Release note / MoonBit (not persistent)",
      ),
    )
    assert_true(page.snapshot().contains("Application shared count: 0"))
    assert_true(page.snapshot().contains("Application request: idle"))
    assert_true(!page.snapshot().contains("private-origin-marker"))
    assert_true(!page.snapshot().contains("private-header-marker"))
  }
  assert_true(
    details.snapshot().contains("Draft save: echoed (not persistent)"),
  )
  assert_true(
    details
    .snapshot()
    .contains("Public API echo demo — not persistent storage"),
  )
}

///|
test "details edits and newer saves suppress stale public API completions" {
  let app = @application.program().create_runtime()
  defer ignore(app.dispose())
  ignore(app.lifecycle("onLaunch", "{}"))
  let details = open_details(app)
  edit_draft(details, "first", "note")
  let (first, _) = save_request(details)
  edit_draft(details, "second", "note")
  ignore(
    details.resolve_effect(first, "success", echo_response("first", "note")),
  )
  ignore(app.flush())
  ignore(details.flush())
  assert_true(
    details
    .snapshot()
    .contains("Application echoed draft: none (not persistent)"),
  )
  assert_true(details.snapshot().contains("Draft save: editing"))
  let (second, _) = save_request(details)
  edit_draft(details, "third", "note")
  let (third, _) = save_request(details)
  ignore(
    details.resolve_effect(third, "success", echo_response("third", "note")),
  )
  ignore(
    details.resolve_effect(second, "success", echo_response("second", "note")),
  )
  ignore(app.flush())
  ignore(details.flush())
  assert_true(
    details
    .snapshot()
    .contains("Application echoed draft: third / note (not persistent)"),
  )
  assert_true(
    !details.snapshot().contains("Application echoed draft: second / note"),
  )
}

///|
test "details reports HTTP and schema errors without publishing failed drafts" {
  let app = @application.program().create_runtime()
  defer ignore(app.dispose())
  ignore(app.lifecycle("onLaunch", "{}"))
  let details = open_details(app)
  edit_draft(details, "draft", "note")
  for
    entry in [
      (
        "success", "{\"statusCode\":503,\"data\":\"private-error-body\"}", "Public API returned HTTP 503",
      ),
      (
        "failure", "{\"error\":\"private-host-error\"}", "Public API request failed; retry when available.",
      ),
      (
        "success", "{\"statusCode\":200,\"data\":{\"json\":{\"title\":42}}}", "Public API response did not match the draft schema.",
      ),
      (
        "success",
        echo_response("different", "note"),
        "Echo did not match the submitted draft.",
      ),
    ] {
    let (phase, response, message) = entry
    let (id, _) = save_request(details)
    ignore(details.resolve_effect(id, phase, response))
    ignore(app.flush())
    ignore(details.flush())
    assert_true(details.snapshot().contains(message))
    assert_true(
      details
      .snapshot()
      .contains("Application echoed draft: none (not persistent)"),
    )
    assert_true(!details.snapshot().contains("private-error-body"))
    assert_true(!details.snapshot().contains("private-host-error"))
  }
}

///|
test "details unload cancels saving and recreated pages retain only shared echoes" {
  let app = @application.program().create_runtime()
  defer ignore(app.dispose())
  ignore(app.lifecycle("onLaunch", "{}"))
  let details = open_details(app)
  edit_draft(details, "saved", "note")
  let (saved, _) = save_request(details)
  ignore(
    details.resolve_effect(saved, "success", echo_response("saved", "note")),
  )
  ignore(app.flush())
  edit_draft(details, "cancelled", "note")
  let (pending, _) = save_request(details)
  assert_true(details.dispose().contains("CancelEffect"))
  assert_eq(
    details.resolve_effect(
      pending,
      "success",
      echo_response("cancelled", "note"),
    ),
    "[]",
  )
  let reopened = open_details(app)
  assert_true(reopened.snapshot().contains("Draft save: idle"))
  assert_true(
    reopened
    .snapshot()
    .contains("Application echoed draft: saved / note (not persistent)"),
  )
  assert_true(!reopened.snapshot().contains("cancelled"))
}
