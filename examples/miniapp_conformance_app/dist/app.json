    "pages/interaction/interaction",
    "pages/capabilities/capabilities",
    "pages/application/application",
    "pages/home/home",
    "pages/lab/lab",
    "pages/details/details"
  ],
  "renderer": "skyline",
  "componentFramework": "glass-easel",
