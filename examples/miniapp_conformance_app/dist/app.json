{
  "pages": [
    "pages/showcase/showcase",
    "pages/interaction/interaction",
    "pages/platform/platform",
    "pages/application/application",
    "pages/request_lifecycle/request_lifecycle",
    "pages/runtime_lab/runtime_lab",
    "pages/draft_editor/draft_editor"
  ],
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "lazyCodeLoading": "requiredComponents",
  "rendererOptions": {
    "skyline": {
