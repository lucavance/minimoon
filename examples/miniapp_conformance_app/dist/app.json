      },
      {
        "text": "交互",
        "iconPath": "assets/tab-interaction.png",
        "selectedIconPath": "assets/tab-interaction-selected.png",
        "pagePath": "pages/interaction/interaction"
      },
      {
        "text": "平台",
        "iconPath": "assets/tab-platform.png",
        "selectedIconPath": "assets/tab-platform-selected.png",
        "pagePath": "pages/platform/platform"
      },
      {
        "text": "应用",
        "iconPath": "assets/tab-application.png",
        "selectedIconPath": "assets/tab-application-selected.png",
        "pagePath": "pages/application/application"
      }
    ]
  }
}
